# ==========================================
# The Pirate Bay - Server Environment Example
# ==========================================
# Copia este archivo como '.env' en esta carpeta y completa los valores.

PORT=3001
CLIENT_ORIGIN=http://localhost:5173

# PostgreSQL Connection String (Local, Supabase, Neon o Render)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/thepiratebay

# Clave secreta para firmar tokens JWT (Cambiar por una cadena aleatoria segura en producción)
JWT_SECRET=pirate_bay_super_secret_jwt_key_2026_change_in_prod

# Google OAuth 2.0 Client ID (El mismo que el del cliente)
GOOGLE_CLIENT_ID=1033239742281-n6ac31nu0n9bpk90qno0fn9nglq0k0ku.apps.googleusercontent.com
